# Copie para .env (ignorado pelo git). O docker compose lê este arquivo sozinho;
# sem ele, valem os mesmos valores padrão abaixo.

# API
PORT=3000

# Só para `cargo run` fora do Docker; no compose a URL é montada com as variáveis POSTGRES_*
DATABASE_URL=postgres://sebo:sebo@localhost:5432/sebo

# Banco (credenciais apenas de desenvolvimento)
POSTGRES_USER=sebo
POSTGRES_PASSWORD=sebo
POSTGRES_DB=sebo

# Usuário do container de desenvolvimento (rode `id -u` e `id -g`)
UID=1000
GID=1000
